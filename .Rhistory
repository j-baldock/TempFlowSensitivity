cntl.list = list(minit = 200, maxit = 5000, allow.degen = FALSE)
fit_1f <- MARSS(result_mat_formatted, model = list(m = 1, R = "equalvarcov"), form = "dfa", silent = TRUE, control = cntl.list)
fit_2f <- MARSS(result_mat_formatted, model = list(m = 2, R = "equalvarcov"), form = "dfa", silent = TRUE, control = cntl.list)
fit_3f <- MARSS(result_mat_formatted, model = list(m = 3, R = "equalvarcov"), form = "dfa", silent = TRUE, control = cntl.list)
