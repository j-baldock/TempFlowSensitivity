smooth_site_draw <- function(df_site_draw) {
# function
# make_fd <- function(df_site_draw) {
#   Data2fd(
#     argvals = month_grid,
#     y = df_site_draw$value,
#     basisobj = basis
#   )
# }
smooth_site_draw <- function(df_site_draw) {
# observed months and values
argvals <- df_site_draw$month
y <- df_site_draw$value
# guard against too few points
if (length(unique(argvals)) < 4) {
return(NULL)
}
smooth.basis(
argvals = argvals,
y = y,
basisobj = basis
)$fd
}
# apply per draw and site
